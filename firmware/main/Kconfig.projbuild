menu "CarbonMirror development endpoint"
config CM_ALLOW_ACTUATION
    bool "Enable relay requests after independent hardware release"
    default n
    help
        Must remain disabled until complete mains design, calibration and physical
        safety review. Compilation is not authorization to energize any load.
config CM_BOARD_REV_B
    bool "Use revision B GPIO3 output-presence feedback"
    default y
config CM_SNTP_SERVER
    string "Commissioned local time server"
    default ""
    help
        Empty disables network time. Provision a trusted campus time service.
endmenu
